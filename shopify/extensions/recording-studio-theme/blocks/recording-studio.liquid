<div
  id="recording-studio-{{ block.id }}"
  data-rs-shop="{{ shop.permanent_domain }}"
  {{ block.shopify_attributes }}
>
  {% assign rs = app.metafields["$app:recording_studio"] %}
  {% assign host = rs["host_base_url"].value %}
  {% assign token = rs["storefront_token"].value %}
  {% assign pages = rs["pages"].value %}
  {% assign page_id = "" %}
  {% if pages %}
    {% for page in pages %}
      {% if page.title == block.settings.page %}
        {% assign page_id = page.id %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if request.design_mode %}
    {% if host == blank or token == blank %}
      Connect the shop on the dummy host so this block can load.
    {% elsif page_id == blank %}
      Pick a page.
    {% endif %}
  {% endif %}
</div>

{% if host != blank and token != blank and page_id != blank %}
  <script
    src="{{ host }}/shopify_plugin_demo/storefront/embed.js?shop={{ shop.permanent_domain }}&page_id={{ page_id }}&token={{ token }}&mount=recording-studio-{{ block.id }}"
    async
    onerror="var root = document.getElementById('recording-studio-{{ block.id }}'); if (root) root.textContent = '{% if request.design_mode %}Could not load this block. Check Connect.{% else %}Nothing to show here yet.{% endif %}';"
  ></script>
{% endif %}

{% schema %}
{
  "name": "Shopify plugin",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "page",
      "label": "Page",
      "options": [
        { "value": "Getting Started", "label": "Getting Started" },
        { "value": "Carousel", "label": "Carousel" }
      ]
    }
  ]
}
{% endschema %}
