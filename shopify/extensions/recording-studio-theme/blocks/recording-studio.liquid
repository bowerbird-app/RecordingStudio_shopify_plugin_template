<div
  id="recording-studio-{{ block.id }}"
  data-rs-host="{{ block.settings.host_base_url }}"
  data-rs-page-id="{{ block.settings.recording_id }}"
  data-rs-shop="{{ shop.permanent_domain }}"
>
  {% if request.design_mode %}
    {% if block.settings.host_base_url == blank or block.settings.recording_id == blank or block.settings.embed_token == blank %}
      Set the host URL, page id, and storefront token here.
    {% endif %}
  {% endif %}
</div>

{% if block.settings.host_base_url != blank and block.settings.recording_id != blank and block.settings.embed_token != blank %}
  <script
    src="{{ block.settings.host_base_url }}/shopify_plugin_demo/storefront/embed.js?shop={{ shop.permanent_domain }}&page_id={{ block.settings.recording_id }}&token={{ block.settings.embed_token }}&mount=recording-studio-{{ block.id }}"
    async
    onerror="var root = document.getElementById('recording-studio-{{ block.id }}'); if (root) root.textContent = '{% if request.design_mode %}Could not load this block. Check Connect and the token.{% else %}Nothing to show here yet.{% endif %}';"
  ></script>
{% endif %}

{% schema %}
{
  "name": "Shopify plugin",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "host_base_url",
      "label": "Host URL",
      "info": "Dummy host origin. Example: http://localhost:3000"
    },
    {
      "type": "text",
      "id": "recording_id",
      "label": "Page id",
      "info": "Page id from dummy Pages."
    },
    {
      "type": "text",
      "id": "embed_token",
      "label": "Storefront token",
      "info": "Token for this shop and page after Connect. Shop comes from this store."
    }
  ]
}
{% endschema %}
