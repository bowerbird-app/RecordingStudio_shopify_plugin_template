<div
  id="recording-studio-{{ block.id }}"
  data-rs-host="{{ block.settings.host_base_url }}"
  data-rs-recording-id="{{ block.settings.recording_id }}"
>
</div>

<script>
  (function () {
    var root = document.getElementById("recording-studio-{{ block.id }}");
    var host = root.getAttribute("data-rs-host");
    var recordingId = root.getAttribute("data-rs-recording-id");
    if (!host || !recordingId) {
      root.textContent = "Set host URL and page id in the theme editor.";
      return;
    }
    root.textContent = "Shopify plugin mount. Host " + host + " page " + recordingId + ".";
  })();
</script>

{% schema %}
{
  "name": "Shopify plugin",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "host_base_url",
      "label": "Recording Studio host URL",
      "info": "Dummy host origin. Example: http://localhost:3000"
    },
    {
      "type": "text",
      "id": "recording_id",
      "label": "Page recording id",
      "info": "UUID from dummy Pages."
    }
  ]
}
{% endschema %}
