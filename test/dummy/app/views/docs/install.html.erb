<% dummy_page_nav(title: "Install", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Install",
    subtitle: "Host-app setup for the mounted recording_studio_shopify_plugin_template engine and its sample migrations.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Step 1",
    subtitle: "Mount recording_studio_shopify_plugin_template, then copy and run its migrations.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      bin/rails generate recording_studio_shopify_plugin_template:install
      bin/rails generate recording_studio_shopify_plugin_template:migrations
      bin/rails db:migrate
    CODE
  ) %>
</div>
