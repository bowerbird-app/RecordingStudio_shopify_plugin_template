<% dummy_page_nav(title: ShopifyPluginDemo::ProductConfig::SETTINGS_TITLE) %>

<div class="flex w-full flex-col items-center gap-6 text-center">
  <%= render FlatPack::PageTitle::Component.new(
    title: ShopifyPluginDemo::ProductConfig::SETTINGS_TITLE,
    subtitle: ShopifyPluginDemo::ProductConfig::SETTINGS_CONNECTED_STATUS,
    variant: :h1
  ) %>

  <%= form_with url: shopify_plugin_demo_disconnect_path(shop: @shop_domain), method: :delete, local: true do %>
    <%= render FlatPack::Button::Component.new(
      text: ShopifyPluginDemo::ProductConfig::DISCONNECT_BUTTON_TEXT,
      style: :secondary,
      size: :md,
      type: :submit
    ) %>
  <% end %>
</div>
