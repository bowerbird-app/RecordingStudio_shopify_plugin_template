<% dummy_page_nav(title: ShopifyPluginDemo::ProductConfig::NAME, back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: ShopifyPluginDemo::ProductConfig::CHANNEL_NAME,
    subtitle: ShopifyPluginDemo::ProductConfig::DESCRIPTION,
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Connect the shop",
          subtitle: @connected ? ShopifyPluginDemo::ProductConfig::SETTINGS_CONNECTED_STATUS : "Install in Shopify Admin, then Connect here.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <p class="text-sm leading-6">
          <% if @connected %>
            This shop is Connected. Open Connect to disconnect or pick pages.
          <% else %>
            Partner install is not Connected. Open Connect from App Home.
          <% end %>
        </p>
      <% end %>
      <% card.footer do %>
        <%= link_to shopify_plugin_demo_connect_url, class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(
            text: "Open Connect",
            style: :primary,
            size: :md
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Pages",
          subtitle: "Open a page to preview the storefront widget.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <p class="text-sm leading-6">
          Storefront mounts the plugin SDK with a browser payload. It does not iframe the host.
        </p>
      <% end %>
      <% card.footer do %>
        <%= link_to pages_path, class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(
            text: "Browse pages",
            style: :secondary,
            size: :md
          ) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
