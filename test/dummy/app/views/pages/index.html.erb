<% dummy_page_nav(title: "Pages", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages",
    subtitle: "Copy a page id into the Shopify plugin theme extension.",
    variant: :h1
  ) %>

  <%= render FlatPack::Table::Component.new(data: @page_recordings, class: "text-sm") do |table| %>
    <% table.column(title: "Title", html: ->(recording) { link_to(recording.recordable.title, page_path(recording)) }) %>
    <% table.column(title: "Page id", html: ->(recording) { tag.code(recording.id) }) %>
  <% end %>
</div>
