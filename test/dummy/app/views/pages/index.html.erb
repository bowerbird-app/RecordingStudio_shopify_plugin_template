<% dummy_page_nav(title: "Pages", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages",
    subtitle: "Copy a page id into the Shopify plugin theme extension.",
    variant: :h1
  ) %>

  <ul class="space-y-3 text-sm leading-6">
    <% @page_recordings.each do |recording| %>
      <li>
        <%= link_to recording.recordable.title, page_path(recording) %>
        <code><%= recording.id %></code>
      </li>
    <% end %>
  </ul>
</div>
